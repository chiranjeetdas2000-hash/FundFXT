# ─── Aiven MySQL (same as Render backend env) ───
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb

# ─── Encryption key (MUST match Render TID_ENCRYPTION_KEY) ───
TID_ENCRYPTION_KEY=your-64-char-hex-key

# ─── Sync mode ───
# TEST_MODE=1 → sync only TEST_ACCOUNT_ID (verbose logs)
# TEST_MODE=0 → full production loop (all pending accounts)
TEST_MODE=1

# Test account (used only when TEST_MODE=1)
# For real accounts, credentials come from tid_accounts table
TEST_ACCOUNT_ID=4

# ─── Loop interval (seconds between cycles in production mode) ───
SYNC_INTERVAL_SECONDS=60

# ─── MT5 terminal path (Windows only, optional) ───
# Leave empty to use default install path
MT5_TERMINAL_PATH=
