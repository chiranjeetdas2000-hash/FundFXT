# ─── Backend API (Render) ───
BACKEND_URL=https://fundfxt.onrender.com
INTERNAL_SYNC_KEY=your-64-char-hex-key-here

# ─── Encryption key (MUST match Render TID_ENCRYPTION_KEY) ───
TID_ENCRYPTION_KEY=your-64-char-hex-key-here

# ─── Polling ───
POLL_INTERVAL_SECONDS=30
BATCH_SIZE=10

# ─── MT5 terminal (Windows) ───
# Leave empty to use default install path (C:\Program Files\MetaTrader 5\terminal64.exe)
MT5_TERMINAL_PATH=

# ─── Dry run (1 = don't POST to backend, just log) ───
DRY_RUN=0