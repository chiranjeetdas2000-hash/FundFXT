{
    "rewrites": [
        {
            "source": "/",
            "destination": "/frontend/home.html"
        },
        {
            "source": "/index.html",
            "destination": "/frontend/home.html"
        },
        {
            "source": "/auth.html",
            "destination": "/frontend/Auth.html"
        },
        {
            "source": "/Auth.html",
            "destination": "/frontend/Auth.html"
        },
        {
            "source": "/dashboard.html",
            "destination": "/frontend/dashboard.html"
        },
        {
            "source": "/account-dashboard.html",
            "destination": "/frontend/account-dashboard-v3.html"
        },
        {
            "source": "/affiliate.html",
            "destination": "/frontend/affiliate-v3.html"
        },
        {
            "source": "/trading-terminal.html",
            "destination": "/frontend/trading.html"
        },
        {
            "source": "/trading.html",
            "destination": "/frontend/trading.html"
        },
        {
            "source": "/order.html",
            "destination": "/frontend/trading.html"
        },
        {
            "source": "/t",
            "destination": "/frontend/tradersid/t.html"
        },
        {
            "source": "/t/",
            "destination": "/frontend/tradersid/t.html"
        },
        {
            "source": "/t/:path*",
            "destination": "/frontend/tradersid/t.html"
        },
        {
            "source": "/tradersid/:path*",
            "destination": "/frontend/tradersid/:path*"
        },
        {
            "source": "/admin/tid",
            "destination": "/frontend/admin/tid/index.html"
        },
        {
            "source": "/admin/tid/",
            "destination": "/frontend/admin/tid/index.html"
        },
        {
            "source": "/admin/tid/:path*",
            "destination": "/frontend/admin/tid/:path*"
        },
        {
            "source": "/admin/:path*",
            "destination": "/frontend/admin/:path*"
        },
        {
            "source": "/:path*",
            "destination": "/frontend/:path*"
        }
    ]
}
